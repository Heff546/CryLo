{
  "name": "crylo-wallet",
  "version": "1.1.1",
  "description": "CryLo Wallet - Official GUI Wallet",
  "main": "main.js",
  "author": {
    "name": "CryLo",
    "email": "crylo@crylo.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win --x64",
    "build-linux": "electron-builder --linux --x64",
    "build-all": "electron-builder --win --linux --mac --x64",
    "build-mac": "electron-builder --mac --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.crylo.wallet",
    "productName": "CryLo Wallet",
    "copyright": "Copyright © 2025 CryLo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/win",
        "to": "bin/win",
        "filter": [
          "**/*",
          "!README.txt"
        ]
      },
      {
        "from": "bin/linux",
        "to": "bin/linux",
        "filter": [
          "**/*",
          "!README.txt"
        ]
      },
      {
        "from": "bin/mac",
        "to": "bin/mac",
        "filter": [
          "**/*",
          "!README.txt"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CryLo Wallet",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Finance"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "assets/icon.png"
    }
  },
  "homepage": "https://crylo.com",
  "dependencies": {
    "ethers": "^6.16.0"
  }
}
