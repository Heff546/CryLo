{
  "name": "crylo-wallet",
  "version": "1.1.1",
  "description": "CryLo Wallet - Official GUI Wallet",
  "main": "main.js",
  "author": {
    "name": "CryLo",
    "email": "crylo@crylo.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/release-native.js",
    "build-win": "node scripts/release-native.js win x64",
    "build-linux": "bash scripts/release-linux.sh auto",
    "build-mac": "node scripts/release-native.js mac auto",
    "sync-linux-binaries": "bash scripts/sync-linux-binaries.sh",
    "verify-linux-binaries": "bash scripts/verify-linux-binaries.sh",
    "release-linux": "bash scripts/release-linux.sh auto",
    "build-linux-arm64": "bash scripts/release-linux.sh arm64",
    "build-linux-x64": "bash scripts/release-linux.sh x64",
    "build-win-x64": "node scripts/release-native.js win x64",
    "build-mac-x64": "node scripts/release-native.js mac x64",
    "build-mac-arm64": "node scripts/release-native.js mac arm64",
    "release-win-x64": "node scripts/release-native.js win x64",
    "release-mac-x64": "node scripts/release-native.js mac x64",
    "release-mac-arm64": "node scripts/release-native.js mac arm64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.crylo.wallet",
    "productName": "CryLo Wallet",
    "copyright": "Copyright \u00a9 2025 CryLo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../node-operator/runtime",
        "to": "operator-runtime",
        "filter": [
          "package.json",
          "package-lock.json",
          "src/**/*",
          "abis/**/*",
          "node_modules/**/*"
        ]
      },
      {
        "from": "../node-operator/protocol",
        "to": "protocol",
        "filter": [
          "package.json",
          "package-lock.json",
          "schemas/**/*",
          "validation/**/*",
          "test-vectors/**/*",
          "examples/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "bin/win",
          "to": "bin/win",
          "filter": [
            "CryLo-daemon.exe",
            "CryLo-wallet-rpc.exe",
            "BINARY-MANIFEST.txt"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CryLo Wallet",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Finance",
      "extraResources": [
        {
          "from": "bin/linux",
          "to": "bin/linux",
          "filter": [
            "CryLo-daemon",
            "CryLo-wallet-rpc",
            "BINARY-MANIFEST.txt"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "bin/mac",
          "to": "bin/mac",
          "filter": [
            "CryLo-daemon",
            "CryLo-wallet-rpc",
            "BINARY-MANIFEST.txt"
          ]
        }
      ]
    },
    "beforePack": "scripts/before-pack.js",
    "afterPack": "scripts/after-pack.js"
  },
  "homepage": "https://crylo.com",
  "dependencies": {
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0"
  }
}
