{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crylonexus:operator:config:schema:v1",
  "title": "CryLoNexus Operator Configuration",
  "description": "Non-secret configuration for a CryLoNexus mainnet operator service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "network",
    "chainId",
    "operatorAddress",
    "tier",
    "rpcUrl",
    "contracts",
    "service",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protocolVersion": {
      "const": 1
    },
    "network": {
      "const": "CryLoNexus Mainnet"
    },
    "chainId": {
      "const": 5546
    },
    "operatorAddress": {
      "$ref": "#/$defs/evmAddress"
    },
    "tier": {
      "type": "string",
      "enum": [
        "Operator",
        "Validator"
      ]
    },
    "rpcUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrappedCryLo",
        "nodeStaking",
        "rewardManager"
      ],
      "properties": {
        "wrappedCryLo": {
          "$ref": "#/$defs/evmAddress"
        },
        "nodeStaking": {
          "$ref": "#/$defs/evmAddress"
        },
        "rewardManager": {
          "$ref": "#/$defs/evmAddress"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceName",
        "statusPath",
        "dataDirectory"
      ],
      "properties": {
        "serviceName": {
          "const": "crylo-nexus-operator.service"
        },
        "statusPath": {
          "type": "string",
          "const": "/var/lib/crylonexus-operator/status.json"
        },
        "dataDirectory": {
          "type": "string",
          "const": "/var/lib/crylonexus-operator"
        },
        "logDirectory": {
          "type": "string",
          "const": "/var/log/crylonexus-operator"
        }
      }
    },
    "nodeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256
        },
        "pairingRequired": {
          "type": "boolean"
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "$defs": {
    "evmAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    }
  }
}
