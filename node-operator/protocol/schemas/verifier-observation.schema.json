{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crylonexus.org/schemas/verifier-observation.schema.json",
  "title": "CryLoNexus Verifier Observation",
  "description": "A verifier's signed evaluation of one operator heartbeat.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "network",
    "chainId",
    "verifierId",
    "operatorAddress",
    "nodeId",
    "heartbeatPayloadHash",
    "observedAt",
    "result",
    "reasonCode",
    "latencyMs",
    "observedBlockNumber",
    "observationHash",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protocolVersion": {
      "const": 1
    },
    "network": {
      "const": "CryLoNexus Mainnet"
    },
    "chainId": {
      "const": 5546
    },
    "verifierId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "operatorAddress": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "nodeId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "heartbeatPayloadHash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "reasonCode": {
      "enum": [
        "HEARTBEAT_VALID",
        "HEARTBEAT_EXPIRED",
        "INVALID_SIGNATURE",
        "PAYLOAD_HASH_MISMATCH",
        "STATUS_HASH_MISMATCH",
        "CHAIN_MISMATCH",
        "IDENTITY_MISMATCH",
        "REGISTRATION_NOT_VERIFIED",
        "RPC_UNREACHABLE",
        "REPLAY_DETECTED",
        "SEQUENCE_ROLLBACK",
        "CLOCK_SKEW",
        "PROTOCOL_UNSUPPORTED"
      ]
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120000
    },
    "observedBlockNumber": {
      "type": "integer",
      "minimum": 0
    },
    "observationHash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{130}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "reasonCode": {
            "const": "HEARTBEAT_VALID"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "FAIL"
          }
        }
      },
      "then": {
        "properties": {
          "reasonCode": {
            "not": {
              "const": "HEARTBEAT_VALID"
            }
          }
        }
      }
    }
  ]
}
