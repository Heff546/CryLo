{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crylonexus.org/schemas/verification-window.schema.json",
  "title": "CryLoNexus Verification Window",
  "description": "Aggregated verifier evidence for one operator over a bounded observation window.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "network",
    "chainId",
    "operatorAddress",
    "nodeId",
    "windowStartedAt",
    "windowEndedAt",
    "expectedHeartbeats",
    "receivedHeartbeats",
    "successfulObservations",
    "failedObservations",
    "distinctVerifiers",
    "successRateBasisPoints",
    "locallyQualified",
    "consensusQualified",
    "rewardAuthorized",
    "reasonCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protocolVersion": {
      "const": 1
    },
    "network": {
      "const": "CryLoNexus Testnet"
    },
    "chainId": {
      "const": 5546
    },
    "operatorAddress": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "nodeId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "windowStartedAt": {
      "type": "string",
      "format": "date-time"
    },
    "windowEndedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expectedHeartbeats": {
      "type": "integer",
      "minimum": 1
    },
    "receivedHeartbeats": {
      "type": "integer",
      "minimum": 0
    },
    "successfulObservations": {
      "type": "integer",
      "minimum": 0
    },
    "failedObservations": {
      "type": "integer",
      "minimum": 0
    },
    "distinctVerifiers": {
      "type": "integer",
      "minimum": 0
    },
    "successRateBasisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "locallyQualified": {
      "type": "boolean"
    },
    "consensusQualified": {
      "type": "boolean"
    },
    "rewardAuthorized": {
      "const": false
    },
    "reasonCode": {
      "enum": [
        "LOCAL_EVIDENCE_ONLY",
        "INSUFFICIENT_HEARTBEATS",
        "INSUFFICIENT_VERIFIERS",
        "SUCCESS_RATE_TOO_LOW",
        "REGISTRATION_NOT_VERIFIED",
        "CONSENSUS_PROTOCOL_NOT_ACTIVE"
      ]
    }
  }
}
