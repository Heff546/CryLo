{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crylonexus.org/schemas/heartbeat-envelope.schema.json",
  "title": "CryLoNexus Operator Heartbeat Envelope",
  "description": "Canonical non-custodial heartbeat evidence emitted by a CryLoNexus operator runtime for external verifier evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "network",
    "chainId",
    "operatorAddress",
    "nodeId",
    "tier",
    "serviceVersion",
    "sequence",
    "issuedAt",
    "expiresAt",
    "nonce",
    "blockNumber",
    "statusHash",
    "payloadHash",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protocolVersion": {
      "const": 1
    },
    "network": {
      "const": "CryLoNexus Mainnet"
    },
    "chainId": {
      "const": 5546
    },
    "operatorAddress": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "nodeId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "tier": {
      "enum": [
        "Operator",
        "Validator"
      ]
    },
    "serviceVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "blockNumber": {
      "type": "integer",
      "minimum": 0
    },
    "statusHash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{130}$"
    }
  }
}
