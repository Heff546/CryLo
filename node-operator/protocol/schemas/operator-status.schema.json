{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crylonexus:operator:status:schema:v1",
  "title": "CryLoNexus Operator Status",
  "description": "Structured status produced by the persistent CryLoNexus operator service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "serviceVersion",
    "network",
    "chainId",
    "nodeId",
    "operatorAddress",
    "startedAt",
    "updatedAt",
    "connected",
    "rpcHealthy",
    "walletMatched",
    "registered",
    "tier",
    "uptimeSeconds",
    "rewardEligible",
    "workers",
    "warnings",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protocolVersion": {
      "const": 1
    },
    "serviceVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "network": {
      "const": "CryLoNexus Mainnet"
    },
    "chainId": {
      "const": 5546
    },
    "nodeId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "operatorAddress": {
      "$ref": "#/$defs/evmAddress"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastHeartbeatAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "connected": {
      "type": "boolean"
    },
    "rpcHealthy": {
      "type": "boolean"
    },
    "walletMatched": {
      "type": "boolean"
    },
    "registered": {
      "type": "boolean"
    },
    "tier": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Operator",
        "Validator",
        null
      ]
    },
    "uptimeSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "rewardEligible": {
      "type": "boolean"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reasonCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heartbeatCount": {
          "type": "integer",
          "minimum": 0
        },
        "successfulChecks": {
          "type": "integer",
          "minimum": 0
        },
        "failedChecks": {
          "type": "integer",
          "minimum": 0
        },
        "pendingRewardsBaseUnits": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "workers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/worker"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/statusMessage"
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/statusMessage"
      }
    }
  },
  "$defs": {
    "evmAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "healthy",
        "successes",
        "errors"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "healthy": {
          "type": "boolean"
        },
        "lastRunAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "successes": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "messageCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        }
      }
    },
    "statusMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "firstSeenAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
