{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crylonexus:operator:release-manifest:schema:v1",
  "title": "CryLoNexus Operator Release Manifest",
  "description": "Signed metadata describing an official CryLoNexus operator release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "version",
    "channel",
    "network",
    "chainId",
    "protocolVersion",
    "configSchemaVersion",
    "statusSchemaVersion",
    "serviceName",
    "minimumElectronVersion",
    "releasedAt",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "CryLoNexus Operator"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "channel": {
      "type": "string",
      "enum": [
        "stable",
        "release-candidate",
        "development"
      ]
    },
    "network": {
      "const": "CryLoNexus Testnet"
    },
    "chainId": {
      "const": 5546
    },
    "protocolVersion": {
      "type": "integer",
      "minimum": 1
    },
    "configSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "statusSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "serviceName": {
      "const": "crylo-nexus-operator.service"
    },
    "minimumElectronVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "releasedAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseNotesUrl": {
      "type": "string",
      "format": "uri"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "linux-amd64": {
          "$ref": "#/$defs/releaseAsset"
        },
        "linux-arm64": {
          "$ref": "#/$defs/releaseAsset"
        }
      }
    }
  },
  "$defs": {
    "releaseAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri"
        },
        "sbomFilename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    }
  }
}
