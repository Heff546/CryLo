#!/usr/bin/env sh
set -eu

SCRIPT="$0"

while [ -L "$SCRIPT" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
  LINK=$(readlink "$SCRIPT")

  case "$LINK" in
    /*)
      SCRIPT="$LINK"
      ;;
    *)
      SCRIPT="$DIR/$LINK"
      ;;
  esac
done

ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
cd "$ROOT"

SYSTEM=$(uname -s)
MACHINE=$(uname -m)

case "$SYSTEM" in
  Linux)
    NODE_PLATFORM=linux

    case "$MACHINE" in
      x86_64|amd64)
        NODE_ARCH=x64
        NODE_SHA256=6e1db87ef58b8819e5d5402eff1536491b18edd8eb7bee5ef7897876e88dc5ff
        ;;
      aarch64|arm64)
        NODE_ARCH=arm64
        NODE_SHA256=724282c3b43aec998aa9527380465b45d229e021b58035f5f4f63095eabfe5d5
        ;;
      *)
        echo "ERROR: Unsupported Linux architecture for CryLo Node.js: $MACHINE" >&2
        exit 1
        ;;
    esac
    ;;
  Darwin)
    NODE_PLATFORM=darwin

    case "$MACHINE" in
      x86_64|amd64)
        NODE_ARCH=x64
        NODE_SHA256=1462cb3b3046b815cf8ea436d3da450ec1a9f11dac7e5a46b0ada5305d7e8097
        ;;
      arm64|aarch64)
        NODE_ARCH=arm64
        NODE_SHA256=bed7eea5325e1108f32ce5228ddd6a5f0f08a499ee42aa7442aea583702f6057
        ;;
      *)
        echo "ERROR: Unsupported macOS architecture for CryLo Node.js: $MACHINE" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "ERROR: Unsupported operating system for the CryLo launcher: $SYSTEM" >&2
    exit 1
    ;;
esac

NODE_VERSION=24.21.0
NODE_NAME="node-v$NODE_VERSION-$NODE_PLATFORM-$NODE_ARCH"
NODE_BASE="$HOME/.local/share/crylo/runtime"
NODE_DIRECTORY="$NODE_BASE/$NODE_NAME"
NODE_ARCHIVE="$NODE_NAME.tar.gz"
NODE_URL="https://nodejs.org/dist/v$NODE_VERSION/$NODE_ARCHIVE"

verify_node_archive() {
  ARCHIVE_PATH="$1"

  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s  %s\n' "$NODE_SHA256" "$ARCHIVE_PATH" |
      sha256sum --check -
    return
  fi

  if command -v shasum >/dev/null 2>&1; then
    ACTUAL_SHA256=$(shasum -a 256 "$ARCHIVE_PATH" | awk '{print $1}')

    if [ "$ACTUAL_SHA256" != "$NODE_SHA256" ]; then
      echo "ERROR: Downloaded CryLo Node.js runtime SHA-256 mismatch." >&2
      exit 1
    fi

    return
  fi

  echo "ERROR: sha256sum or shasum is required to verify the CryLo Node.js runtime." >&2
  exit 1
}

install_crylo_node_runtime() {
  echo "Installing isolated CryLo Node.js $NODE_VERSION runtime for $NODE_PLATFORM/$NODE_ARCH..."

  mkdir -p "$NODE_BASE"

  TEMP_DIRECTORY=$(mktemp -d "$NODE_BASE/.node-install.XXXXXX")

  cleanup_node_download() {
    rm -rf "$TEMP_DIRECTORY"
  }

  trap cleanup_node_download EXIT HUP INT TERM

  if command -v curl >/dev/null 2>&1; then
    curl \
      --fail \
      --location \
      --silent \
      --show-error \
      --proto '=https' \
      --tlsv1.2 \
      "$NODE_URL" \
      --output "$TEMP_DIRECTORY/$NODE_ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -q \
      "$NODE_URL" \
      -O "$TEMP_DIRECTORY/$NODE_ARCHIVE"
  else
    echo "ERROR: curl or wget is required to install the CryLo Node.js runtime." >&2
    exit 1
  fi

  verify_node_archive "$TEMP_DIRECTORY/$NODE_ARCHIVE"

  tar \
    -xzf "$TEMP_DIRECTORY/$NODE_ARCHIVE" \
    -C "$TEMP_DIRECTORY"

  if [ ! -x "$TEMP_DIRECTORY/$NODE_NAME/bin/node" ] ||
     [ ! -x "$TEMP_DIRECTORY/$NODE_NAME/bin/npm" ]; then
    echo "ERROR: Downloaded CryLo Node.js runtime is incomplete." >&2
    exit 1
  fi

  INSTALLED_VERSION=$(
    "$TEMP_DIRECTORY/$NODE_NAME/bin/node" --version
  )

  if [ "$INSTALLED_VERSION" != "v$NODE_VERSION" ]; then
    echo "ERROR: Downloaded CryLo Node.js runtime version mismatch." >&2
    exit 1
  fi

  rm -rf "$NODE_DIRECTORY"

  mv \
    "$TEMP_DIRECTORY/$NODE_NAME" \
    "$NODE_DIRECTORY"

  trap - EXIT HUP INT TERM
  cleanup_node_download
}

if [ ! -x "$NODE_DIRECTORY/bin/node" ] ||
   [ ! -x "$NODE_DIRECTORY/bin/npm" ]; then
  install_crylo_node_runtime
fi

CURRENT_NODE_VERSION=$(
  "$NODE_DIRECTORY/bin/node" --version 2>/dev/null || true
)

if [ "$CURRENT_NODE_VERSION" != "v$NODE_VERSION" ]; then
  echo "Existing CryLo Node.js runtime is invalid; reinstalling..."
  rm -rf "$NODE_DIRECTORY"
  install_crylo_node_runtime
fi

PATH="$NODE_DIRECTORY/bin:$PATH"
export PATH

CRYLO_NODE_RUNTIME="$NODE_DIRECTORY"
export CRYLO_NODE_RUNTIME

exec node "$ROOT/scripts/crylo.js" "$@"
