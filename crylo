#!/usr/bin/env sh
set -eu

SCRIPT="$0"

while [ -L "$SCRIPT" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
  LINK=$(readlink "$SCRIPT")

  case "$LINK" in
    /*)
      SCRIPT="$LINK"
      ;;
    *)
      SCRIPT="$DIR/$LINK"
      ;;
  esac
done

ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
cd "$ROOT"

NODE_READY=false

if command -v node >/dev/null 2>&1 &&
   command -v npm >/dev/null 2>&1; then
  NODE_MAJOR=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)

  case "$NODE_MAJOR" in
    ''|*[!0-9]*)
      ;;
    *)
      if [ "$NODE_MAJOR" -ge 20 ]; then
        NODE_READY=true
      fi
      ;;
  esac
fi

if [ "$NODE_READY" != true ]; then
  if [ "$(uname -s)" != "Linux" ]; then
    echo "ERROR: Node.js 20 or newer and npm are required to run CryLo." >&2
    exit 1
  fi

  case "$(uname -m)" in
    x86_64|amd64)
      NODE_ARCH=x64
      NODE_SHA256=19e56f0825510207dd904f087fe52faa0a4eb6b2aab5f0ea7a33830d04888b8b
      ;;
    aarch64|arm64)
      NODE_ARCH=arm64
      NODE_SHA256=47ef73d543ecf6eb19435f6c03a0ac4809b3bf0dd6b26c7c571efc2a6572a74d
      ;;
    *)
      echo "ERROR: Unsupported Linux architecture for Node.js: $(uname -m)" >&2
      exit 1
      ;;
  esac

  NODE_VERSION=20.20.2
  NODE_NAME="node-v$NODE_VERSION-linux-$NODE_ARCH"
  NODE_BASE="$HOME/.local/share/crylo"
  NODE_DIRECTORY="$NODE_BASE/$NODE_NAME"
  NODE_ARCHIVE="$NODE_NAME.tar.gz"
  NODE_URL="https://nodejs.org/dist/v$NODE_VERSION/$NODE_ARCHIVE"

  if [ ! -x "$NODE_DIRECTORY/bin/node" ] ||
     [ ! -x "$NODE_DIRECTORY/bin/npm" ]; then
    echo "Installing the CryLo Node.js 20 runtime for Linux/$NODE_ARCH..."

    TEMP_DIRECTORY=$(mktemp -d)

    cleanup_node_download() {
      rm -rf "$TEMP_DIRECTORY"
    }

    trap cleanup_node_download EXIT HUP INT TERM

    if command -v curl >/dev/null 2>&1; then
      curl --fail --location --silent --show-error \
        "$NODE_URL" \
        --output "$TEMP_DIRECTORY/$NODE_ARCHIVE"
    elif command -v wget >/dev/null 2>&1; then
      wget -q \
        "$NODE_URL" \
        -O "$TEMP_DIRECTORY/$NODE_ARCHIVE"
    else
      echo "ERROR: curl or wget is required to install Node.js." >&2
      exit 1
    fi

    (
      cd "$TEMP_DIRECTORY"
      printf '%s  %s\n' "$NODE_SHA256" "$NODE_ARCHIVE" |
        sha256sum --check -
    )

    mkdir -p "$NODE_BASE"
    tar -xzf "$TEMP_DIRECTORY/$NODE_ARCHIVE" -C "$NODE_BASE"

    trap - EXIT HUP INT TERM
    cleanup_node_download
  fi

  PATH="$NODE_DIRECTORY/bin:$PATH"
  export PATH
fi

if ! command -v node >/dev/null 2>&1 ||
   ! command -v npm >/dev/null 2>&1; then
  echo "ERROR: Node.js or npm is unavailable after installation." >&2
  exit 1
fi

exec node "$ROOT/scripts/crylo.js" "$@"
